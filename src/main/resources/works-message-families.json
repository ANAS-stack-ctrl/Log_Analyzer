    {"id": "MET-029", "group": "processus-metier", "label": "Point de contrôle (ENTREE / SORTIE)", "patterns": ["ENTREE[_\\s][A-Z]", "SORTIE[_\\s][A-Z]", "trCheckPoint"], "extractable": ["checkpoint"], "status": "OK"},
