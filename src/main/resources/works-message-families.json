    {"id": "MET-027", "group": "donnees-metier", "label": "Identifiant métier (noDUM, refDemande…)", "patterns": ["\\b(noDUM|noUnite|refDemande|refBad|codeSecu)\\s*[=:]"], "extractable": ["businessKey", "businessValue"], "status": "OK"},
    {"id": "MET-028", "group": "donnees-metier", "label": "Paramètre requête (wv*, f*)", "patterns": ["\\b(wv[A-Za-z0-9_]+|f[A-Za-z0-9_]+)\\s*=\\["], "extractable": ["queryParam"], "attachToGraph": false, "status": "OK"},
    {"id": "MET-025", "group": "donnees-metier", "label": "Identifiant transaction", "patterns": ["transactionId\\s*[\\[(]"], "extractable": ["transactionId"], "attachToGraph": false, "status": "OK"},
    {"id": "MET-026", "group": "infra", "label": "Nom de thread", "patterns": ["thread name\\s*\\["], "extractable": ["threadName"], "attachToGraph": false, "status": "OK"},
    {"id": "EXT-004", "group": "infra", "label": "Fichier log saveLoad", "patterns": ["saveLoadLogFile"], "extractable": [], "attachToGraph": false, "status": "PARTIEL"},

    {"id": "MET-003", "group": "filtre-recherche", "label": "Classe métier (className crochet)", "patterns": ["className\\s*\\["], "extractable": ["object"], "status": "OK"},
    {"id": "MET-004", "group": "filtre-recherche", "label": "Classe métier (className libre)", "patterns": ["className\\s+[A-Za-z]"], "extractable": ["object"], "status": "OK"},
    {"id": "MET-001", "group": "filtre-recherche", "label": "Code filtre dans le message", "patterns": ["filter code\\s*\\["], "extractable": ["filter", "uuid"], "status": "OK"},
    {"id": "MET-024", "group": "commun", "label": "UUID transaction filtre", "patterns": ["uuid\\s*\\["], "extractable": ["uuid"], "attachToGraph": false, "status": "OK"},
    {"id": "EXT-005", "group": "infra", "label": "Version WORKS (ligne technique)", "patterns": ["Works-\\d+\\.\\d+-\\d{4}-", "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}$"], "extractable": [], "attachToGraph": false, "status": "OK"}
  ]
}
